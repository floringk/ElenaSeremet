[
  {
    "name": "Rate limit contact",
    "active": true,
    "conditionGroup": [
      {
        "conditions": [
          { "type": "path", "op": "eq", "value": "/api/contact" },
          { "type": "method", "op": "eq", "value": "POST" }
        ]
      }
    ],
    "action": {
      "mitigate": {
        "action": "rate_limit",
        "rateLimit": {
          "algo": "fixed_window",
          "window": 600,
          "limit": 5,
          "keys": ["ip"],
          "action": "deny"
        }
      }
    }
  },
