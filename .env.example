# Local dev / tests: when NODE_ENV is not production, missing vars use placeholders (see lib/server-env.ts).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Payload CMS (Postgres; can be the same DB as Supabase with a separate connection string)
PAYLOAD_SECRET=
# Preferred: direct (non-pooling) URI. On Vercel Marketplace, POSTGRES_URL_NON_POOLING is also accepted as fallback.
PAYLOAD_DATABASE_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_URL=
# Used only by npm run cms:create-admin / cms:reset-admin — NOT login vars for /cms (see README)
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=
# auto | cms | legacy — how public pages load content (default: auto = CMS if configured, else JSON)
CONTENT_SOURCE=auto

# Imagini: path-uri /content/images/... în CMS (fără upload). Pentru Supabase Storage + S3, vezi docs/VERCEL-DEPLOY.md
# Public site URL (canonical, sitemap, OG). Set on Vercel before custom domain cutover.
NEXT_PUBLIC_SITE_URL=https://elenaseremet.ro

# Payload CMS media upload via Supabase Storage (S3-compatible). Optional — without these, Media uses local `media/` dir.
# Run scripts/supabase-storage-setup.sql first, then create S3 access keys in Supabase → Storage → S3.
SUPABASE_STORAGE_BUCKET=cms-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=eu-central-1
# Optional; auto-derived from SUPABASE_URL when empty:
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3

# Google Tag Manager — set when you have the container ID (site is ready without it)
NEXT_PUBLIC_GTM_ID=

# Google Search Console — HTML tag verification content=… (optional until you verify)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional LocalBusiness geo (decimal degrees)
SITE_GEO_LAT=
SITE_GEO_LNG=

# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=the studio inbox, SMTP_PASS=16-char app password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional: protects POST /api/internal/alert (server-to-server tools only)
INTERNAL_ALERT_KEY=

# Optional: comma-separated profile URLs for Organization JSON-LD (sameAs)
SITE_SAME_AS=
