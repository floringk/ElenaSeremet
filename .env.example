# Local dev / tests: when NODE_ENV is not production, missing vars use placeholders (see lib/server-env.ts).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Payload CMS (Postgres; can be the same DB as Supabase with a separate connection string)
PAYLOAD_SECRET=
PAYLOAD_DATABASE_URL=
# Used only by npm run cms:create-admin / cms:reset-admin — NOT login vars for /cms (see README)
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=
# auto | cms | legacy — how public pages load content (default: auto = CMS if configured, else JSON)
CONTENT_SOURCE=auto

# Imagini: path-uri /content/images/... în CMS (fără upload). Pentru Supabase Storage + S3, vezi docs/VERCEL-DEPLOY.md
# Public site URL (canonical, sitemap, OG). Set on Vercel before custom domain cutover.
NEXT_PUBLIC_SITE_URL=https://elenaseremet.ro

# Google Tag Manager (optional — loads after cookie consent)
NEXT_PUBLIC_GTM_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional: protects POST /api/internal/alert (server-to-server tools only)
INTERNAL_ALERT_KEY=

# Optional: comma-separated profile URLs for Organization JSON-LD (sameAs)
SITE_SAME_AS=
