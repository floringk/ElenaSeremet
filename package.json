{
  "name": "elena-seremet-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-content-to-public.mjs && next dev",
    "build": "node scripts/sync-content-to-public.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "images:assign-random": "node scripts/assign-random-new-images.mjs",
    "assets:bootstrap": "node scripts/bootstrap-public-assets.mjs",
    "postinstall": "node scripts/patch-payload-loadenv.cjs",
    "import:pages": "tsx scripts/import-legacy-pages.ts",
    "cms:create-admin": "node scripts/patch-payload-loadenv.cjs && tsx scripts/create-payload-admin.ts",
    "cms:reset-admin": "node scripts/patch-payload-loadenv.cjs && tsx scripts/reset-payload-admin.ts",
    "cms:fix-home-hero": "node scripts/patch-payload-loadenv.cjs && tsx scripts/fix-home-hero.ts",
    "cms:sync-hero-paths": "node scripts/patch-payload-loadenv.cjs && tsx scripts/import-media-to-payload.ts",
    "cms:clear-media-refs": "node scripts/patch-payload-loadenv.cjs && tsx scripts/clear-cms-media-refs.ts",
    "cms:import-media": "npm run cms:sync-hero-paths",
    "cms:import-membership": "node scripts/patch-payload-loadenv.cjs && tsx scripts/import-membership-to-payload.ts",
    "cms:seed": "node scripts/patch-payload-loadenv.cjs && tsx scripts/seed-cms-content.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@supabase/supabase-js": "^2.105.1",
    "dotenv": "^17.4.2",
    "next": "^16.2.2",
    "nodemailer": "^8.0.7",
    "payload": "^3.84.1",
    "pg": "^8.20.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "callsites": "^4.2.0",
    "es-abstract": "^1.24.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.1",
    "png-to-ico": "^3.0.1",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
